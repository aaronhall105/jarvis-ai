      "bridge/app/main.py",
      "bridge/app/voice_session_engine.py",
      "bridge/tests/test_voice_session_engine.py",
      "bridge/app/dialogue_manager.py"
    ],
    "interruption": [
      "bridge/app/realtime_voice.py",

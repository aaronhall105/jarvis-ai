{
  "version": 1,
  "allow_auto_deploy_low_risk": false,
  "max_context_files": 6,
  "max_context_characters": 180000,
  "allowed_context_paths": [
    "bridge/app/*.py",
    "bridge/tests/*.py",
    "bridge/requirements.txt"
  ],
  "allowed_edit_paths": [
    "bridge/app/*.py",
    "bridge/tests/*.py",
    "bridge/tests/**/*.py",
    "bridge/tests/regressions/*.json",
    "config/aliases*.json"
  ],
  "forbidden_paths": [
    ".env",
    ".env.*",
    "data/**",
    "logs/**",
    ".git/**",
    ".github/**",
    "docker-compose.yml",
    "bridge/Dockerfile",
    "bridge/requirements.txt",
    "tools/**",
    "systemd/**",
    "config/self_improvement_policy.json",
    "config/*token*",
    "config/*secret*",
    "config/*credential*"
  ],
  "high_risk_paths": [
    "bridge/app/admin_engine.py",
    "bridge/app/home_assistant.py",
    "bridge/app/self_improvement.py",
    "bridge/app/config.py",
    "bridge/app/main.py"
  ],
  "medium_risk_paths": [
    "bridge/app/ai_engine.py",
    "bridge/app/tool_engine.py",
    "bridge/app/dialogue_manager.py",
    "bridge/app/memory_engine.py",
    "bridge/app/user_context.py",
    "bridge/app/house_awareness.py"
  ],
  "forbidden_added_patterns": [
    "shell\\s*=\\s*True",
    "\\bos\\.system\\s*\\(",
    "\\beval\\s*\\(",
    "\\bexec\\s*\\(",
    "\\bpickle\\.(?:loads?|load)\\s*\\(",
    "/var/run/docker\\.sock",
    "subprocess\\.(?:Popen|run|call|check_output)\\s*\\(",
    "yaml\\.load\\s*\\(",
    "requests\\.(?:get|post|put|delete)\\s*\\(",
    "httpx\\.(?:get|post|put|delete)\\s*\\("
  ],
  "context_files_by_keyword": {
    "voice": [
      "bridge/app/realtime_voice.py",
      "bridge/tests/test_realtime_voice.py",
      "bridge/app/main.py",
      "bridge/app/voice_session_engine.py",
      "bridge/tests/test_voice_session_engine.py",
      "bridge/app/dialogue_manager.py"
    ],
    "barge": [
      "bridge/app/realtime_voice.py",
      "bridge/tests/test_realtime_voice.py",
      "bridge/app/main.py",
      "bridge/app/voice_session_engine.py",
      "bridge/tests/test_voice_session_engine.py",
      "bridge/app/dialogue_manager.py"
    ],
    "realtime": [
      "bridge/app/realtime_voice.py",
      "bridge/tests/test_realtime_voice.py",
      "bridge/app/main.py",
      "bridge/app/voice_session_engine.py",
      "bridge/tests/test_voice_session_engine.py",
      "bridge/app/dialogue_manager.py"
    ],
    "real-time": [
      "bridge/app/realtime_voice.py",

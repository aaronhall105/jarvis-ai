  },
  "wake_phrase": {
    "enabled": true,
    "default": "jarvis",
    "on_device_preferred": true,
    "follow_up_seconds": 45
  },
  "home_assistant_changes": false,
  "workflow": ".github/workflows/android-unified-voice-v17.3.0.yml",
  "artifact": "jarvis-voice-client-v17.3.0-debug"

[Unit]
Description=Jarvis supervised self-improvement worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__JARVIS_ROOT__
ExecStart=__JARVIS_ROOT__/.venv-improver/bin/python __JARVIS_ROOT__/tools/self_improvement_worker.py daemon

Restart=on-failure
RestartSec=20
TimeoutStopSec=30

Nice=10
IOSchedulingClass=idle
UMask=0077

NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

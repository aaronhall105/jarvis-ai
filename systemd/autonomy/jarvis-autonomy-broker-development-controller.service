[Unit]
Description=Owner-gated Jarvis supervised development controller
Requires=jarvis-autonomy-guardian.service
After=jarvis-autonomy-guardian.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/jarvis-autonomy-broker/entry.py development-controller
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jarvis-autonomy-broker/work
ReadOnlyPaths=/home/aaron/jarvis-unified-production-worktree /var/lib/jarvis-autonomy /var/lib/jarvis-autonomy-guardian /etc/jarvis-autonomy /usr/local/libexec/jarvis-autonomy-broker
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
MemoryMax=512M
CPUQuota=100%
TimeoutStartSec=150
TimeoutStopSec=20
KillMode=mixed
StandardOutput=null
StandardError=journal

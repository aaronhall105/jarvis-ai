[Unit]
Description=Protected read-only Jarvis pending development-task publisher
Requires=jarvis-autonomy-guardian.service
After=jarvis-autonomy-guardian.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/jarvis-autonomy-broker/entry.py development-publication
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/jarvis-autonomy/work /var/lib/jarvis-autonomy-guardian /etc/jarvis-autonomy /usr/local/libexec/jarvis-autonomy-broker
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
TasksMax=16
MemoryMax=128M
CPUQuota=50%
TimeoutStopSec=20
KillMode=mixed
StandardOutput=null
StandardError=journal

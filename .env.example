JARVIS_NAME=Jarvis Core
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_TIMEZONE=Europe/London

# Core providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Realtime voice authentication/provider
JARVIS_REALTIME_ENABLED=true
JARVIS_MOBILE_VOICE_TOKEN=
JARVIS_VOICE_PE_TOKEN=
JARVIS_REALTIME_MODEL=gpt-realtime
JARVIS_REALTIME_VOICE=marin
JARVIS_REALTIME_USER_ID=aaron
JARVIS_REALTIME_USER_NAME=Aaron
JARVIS_REALTIME_USER_IS_ADMIN=true
JARVIS_REALTIME_TRANSCRIPTION_PROMPT=
JARVIS_MOBILE_QUIET_CONTROLS=true
JARVIS_TTS_PROVIDER=openai

# Optional ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Protected administration endpoints
JARVIS_MEMORY_ADMIN_TOKEN=
JARVIS_PRIVILEGED_ADMIN_TOKEN=
JARVIS_SELF_IMPROVEMENT_ADMIN_TOKEN=

# House awareness / proactive assistance
JARVIS_AWARENESS_ENABLED=true
JARVIS_AWARENESS_RETENTION_DAYS=30
JARVIS_PROACTIVE_ENABLED=false
JARVIS_PROACTIVE_MIN_IMPORTANCE=80
JARVIS_PROACTIVE_TARGET=living_room
JARVIS_PROACTIVE_COOLDOWN_SECONDS=300
JARVIS_PROACTIVE_BATTERY_LOW_PERCENT=15
JARVIS_PROACTIVE_BATTERY_CRITICAL_PERCENT=5
JARVIS_PROACTIVE_OVEN_ENTITIES=

# Self-improvement
JARVIS_SELF_IMPROVEMENT_ENABLED=true
JARVIS_SELF_IMPROVEMENT_AUTO_PREPARE=true
JARVIS_SELF_IMPROVEMENT_REPEAT_THRESHOLD=2
JARVIS_SELF_IMPROVEMENT_LATENCY_FAILURE_MS=7000

# Vision Intelligence
JARVIS_VISION_ENABLED=true
JARVIS_FRIGATE_URL=
JARVIS_FRIGATE_TOKEN=
JARVIS_VISION_MODEL=gpt-5-mini
JARVIS_VISION_POLL_SECONDS=10
JARVIS_VISION_DUPLICATE_SECONDS=120
JARVIS_VISION_RETENTION_DAYS=30
JARVIS_VISION_CAMERA_OFFLINE_SECONDS=120
JARVIS_VISION_AUTO_DESCRIBE_QUERIES=true
JARVIS_VISION_LABELS=person,package,car,truck,motorcycle,bicycle

# Response budgets
JARVIS_MAX_OUTPUT_TOKENS=2600
JARVIS_VOICE_MAX_OUTPUT_TOKENS=1800

# Voice PE multi-user Voice ID (present in the audited 4b6b8ec baseline).
# Identity is convenience context, never a sole factor for high-impact actions.
JARVIS_SPEAKER_IDENTITY_ENABLED=true
JARVIS_SPEAKER_IDENTITY_URL=http://jarvis-speaker-verifier:8091
JARVIS_SPEAKER_IDENTITY_TIMEOUT_SECONDS=3.0
JARVIS_SPEAKER_CAPTURE_DIAGNOSTICS=false

# Legacy/fail-open suppression path retained for compatibility.
JARVIS_SPEAKER_VERIFY_URL=http://jarvis-speaker-verifier:8091/score
JARVIS_SPEAKER_SUPPRESSION_ENABLED=false

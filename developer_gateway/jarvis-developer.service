[Unit]
Description=Jarvis authenticated Codex developer gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/jarvis-developer/current
LoadCredential=jarvis-developer-token:%h/.config/jarvis/developer-token
ExecStart=%h/.local/share/jarvis-developer/venv/bin/uvicorn developer_gateway.app:app --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
LockPersonality=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
Environment=JARVIS_AUTHORITATIVE_WORKSPACE=__JARVIS_ROOT__
ReadWritePaths=__JARVIS_ROOT__ %h/.codex %h/.local/share/jarvis-developer /tmp

[Install]
WantedBy=default.target
